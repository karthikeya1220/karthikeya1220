# GitHub Personal Access Token with 'repo' scope (for private contribution access)
# Required for accurate streak calculation including private contributions
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: custom streak start date (YYYY-MM-DD)
# Use this if your streak started before the current calendar window.
# Example: STREAK_START_DATE=2025-10-17
STREAK_START_DATE=2025-10-17

# Optional: change default username if you want to use this for other profiles
# DEFAULT_USERNAME=karthikeya1220
